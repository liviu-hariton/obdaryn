---
// SPDX-License-Identifier: GPL-3.0-or-later
//
// "Page not found", in the language of the part of the site the visitor was in
// (the server picks /ro/404/ under /ro/, see public/ro/.htaccess), with the other
// language under it.
import Base from "../layouts/Base.astro";
import { routes, t, type Lang } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const other: Lang = lang === "en" ? "ro" : "en";
const here = t(lang).notFound;
const there = t(other).notFound;
---
<Base lang={lang} page="404" title={here.title} description={here.text} noindex>
  <div class="wrap page">
    <p class="code">404</p>
    <h1>{here.title}</h1>
    <p>{here.text} <a href={routes[lang].home}>{here.home}</a></p>
    <p lang={other} class="other">{there.text} <a href={routes[other].home}>{there.home}</a></p>
  </div>
  <!-- Code pages are named in capitals (/codes/P0420/). Someone who typed
       /codes/p0420/ lands here: send them to the capitalised address. -->
  <script is:inline>
    (() => {
      const path = location.pathname;
      if (!/^\/(codes|ro\/coduri)\//.test(path)) return;
      const fixed = path.replace(/\/([pbcu][0-9a-f]{4})(?=[-\/])/gi, (m, code) => "/" + code.toUpperCase());
      if (fixed !== path) location.replace(fixed + location.search + location.hash);
    })();
  </script>
</Base>
<style>
  .page { padding-top: clamp(48px, 8vw, 112px); }
  .code { font: 600 clamp(76px, 11vw, 160px)/1 var(--mono); letter-spacing: -0.04em; color: var(--text-faint); }
  h1 { font-size: 32px; letter-spacing: -0.02em; margin: var(--s4) 0 var(--s3); }
  p { color: var(--text-muted); }
  .other { margin-top: var(--s2); }
</style>
