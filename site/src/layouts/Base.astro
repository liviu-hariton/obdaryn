---
// SPDX-License-Identifier: GPL-3.0-or-later
//
// Every page: the head (title, description, language alternates, social card),
// the top bar (sticky, with the theme button), and the footer. No scripts from
// anywhere else, no cookies: the theme choice stays in the browser's own storage.
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { routes, t, type Lang, type PageId } from "../i18n/ui";
import { coffeeUrl, copyrightYears, contactEmail, repoUrl } from "../data/site";
import { codeStrings } from "../i18n/codes";

interface Props {
  lang: Lang;
  page: PageId | "404";
  title: string;
  description: string;
  /** Pages outside the fixed routes (a code's page): this page's address in each
   *  language it exists in. Without the other language, the switch goes to its home. */
  here?: Partial<Record<Lang, string>>;
  /** Keep the page out of search results (the download-started page, the 404s). */
  noindex?: boolean;
  /** The same content as Markdown (the guide), announced to agents with rel="alternate". */
  markdown?: string;
  /** Structured data (schema.org JSON-LD) describing the page for search engines. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { lang, page, title: pageTitle, description: pageDescription, here, noindex = false, markdown, jsonLd } = Astro.props;
// Search results show about 60 characters of a title and 160 of a description.
// The site's name goes after the page's own title when it fits and isn't there yet.
const title = pageTitle.includes("Obdaryn") || pageTitle.length + 10 > 65 ? pageTitle : `${pageTitle} · Obdaryn`;
const description = pageDescription.length <= 160
  ? pageDescription
  : pageDescription.slice(0, 157).replace(/[\s,;:.(–-]+\S*$/, "") + "…";
// JSON-LD inside <script>: "<" escaped so a text can never close the tag.
const ld = jsonLd && JSON.stringify(jsonLd).replace(/</g, "\\u003c");
const s = t(lang);
const other: Lang = lang === "en" ? "ro" : "en";
const r = routes[lang];
const site = Astro.site!;
const pathIn = (l: Lang) => (here ? here[l] : page === "404" ? undefined : routes[l][page]);
const canonical = pathIn(lang) && new URL(pathIn(lang)!, site).href;
const alternates = (["en", "ro"] as Lang[]).flatMap((l) => (pathIn(l) ? [{ l, href: new URL(pathIn(l)!, site).href }] : []));
const otherHref = pathIn(other) ?? routes[other].home;
const nav = [
  { id: "codes", href: r.codes, label: codeStrings[lang].nav },
  { id: "cars", href: r.cars, label: s.nav.cars },
  { id: "guide", href: r.guide, label: s.nav.guide },
  { id: "download", href: r.download, label: s.nav.download },
] as const;
const ogImage = new URL(`/og-${lang}.png`, site).href;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {canonical && <link rel="canonical" href={canonical} />}
  {noindex && <meta name="robots" content="noindex" />}
  {alternates.length > 1 && alternates.map(({ l, href }) => <link rel="alternate" hreflang={l} href={href} />)}
  {alternates.length > 1 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#F7F8FA" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0F1114" media="(prefers-color-scheme: dark)" />
  <!-- Before the first paint: apply the theme the visitor picked earlier, so the
       page never flashes the other one. Without a saved choice it follows the system. -->
  <script is:inline>
    try {
      const saved = localStorage.getItem("obdaryn-theme");
      if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
    } catch {}
  </script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Obdaryn" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content={lang === "ro" ? "ro_RO" : "en_GB"} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={s.ogAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={s.ogAlt} />
  {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
  {ld && <script type="application/ld+json" set:html={ld} />}
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">{s.skip}</a>
  <header class="top" id="top" tabindex="-1">
    <div class="wrap top-inner">
      <a class="brand" href={r.home} aria-label="Obdaryn">
        <img class="when-light" src="/logo.svg" alt="" width="36" height="36" />
        <img class="when-dark" src="/logo-dark.svg" alt="" width="36" height="36" />
        <span>Obdaryn</span>
      </a>
      <nav aria-label={lang === "ro" ? "Principal" : "Main"}>
        <ul>
          {nav.map((n) => (
            <li class={n.id === "download" ? "nav-download" : undefined}>
              <a class="hit" href={n.href} aria-current={n.id === page && n.id !== "home" ? "page" : undefined}>{n.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="tools">
        <a class="gh hit" href={repoUrl} aria-label={s.nav.githubLabel} title={s.nav.githubLabel}><Icon name="github" /></a>
        <!-- Hidden until the script below runs: without JavaScript it couldn't work. -->
        <button type="button" class="theme hit" data-theme-toggle hidden aria-pressed="false"
                aria-label={s.theme.label} data-to-dark={s.theme.toDark} data-to-light={s.theme.toLight}>
          <Icon name="moon" class="when-light" />
          <Icon name="sun" class="when-dark" />
        </button>
        <a class="lang hit" href={otherHref} hreflang={other} lang={other}>{s.otherLang}</a>
      </div>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="foot">
    <div class="wrap foot-inner">
      <div class="foot-brand">
        <a class="brand" href={r.home}>
          <img class="when-light" src="/logo.svg" alt="" width="32" height="32" loading="lazy" />
          <img class="when-dark" src="/logo-dark.svg" alt="" width="32" height="32" loading="lazy" />
          <span>Obdaryn</span>
        </a>
        <p>{s.footer.tagline}</p>
        <p class="coffee-note">{s.footer.coffeeNote}</p>
        <a class="coffee" href={coffeeUrl} rel="noopener"><Icon name="coffee" size={17} />{s.footer.coffee}</a>
      </div>
      <ul class="foot-links">
        <li><a href={r.download}>{s.nav.download}</a></li>
        <li><a href={r.codes}>{codeStrings[lang].short}</a></li>
        <li><a href={r.guide}>{s.nav.guide}</a></li>
        <li><a href={r.cars}>{s.nav.cars}</a></li>
        <li><a href={r.privacy}>{s.footer.privacy}</a></li>
        <li><a class="with-mark" href={repoUrl}><Icon name="github" size={15} />{s.nav.github}</a></li>
        <li><a href={`mailto:${contactEmail}`}>{s.footer.contact}</a></li>
        <li><a href={otherHref} hreflang={other} lang={other}>{s.otherLang}</a></li>
      </ul>
      <div class="foot-small">
        <p>{s.footer.noTracking}</p>
        <p>{s.footer.copyright(copyrightYears)}</p>
      </div>
    </div>
  </footer>

  <!-- Back to top: appears once the page has been scrolled a good way down.
       Hidden until the script below runs; without JavaScript the Home key does it. -->
  <a class="to-top" href="#top" data-to-top hidden aria-label={s.toTop} title={s.toTop}><Icon name="arrow-up" /></a>
  <script>
    // The theme button flips light and dark and remembers the choice in this
    // browser. Until it's used, the site follows the system theme, live.
    const root = document.documentElement;
    const systemDark = matchMedia("(prefers-color-scheme: dark)");
    const isDark = () => (root.dataset.theme ? root.dataset.theme === "dark" : systemDark.matches);
    const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")];

    const sync = () => {
      const dark = isDark();
      for (const b of buttons) {
        b.setAttribute("aria-pressed", String(dark));
        b.title = (dark ? b.dataset.toLight : b.dataset.toDark) ?? "";
      }
      // The browser's own chrome (Safari's tab bar, mobile status bars) follows too.
      for (const m of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) {
        m.content = dark ? "#0F1114" : "#F7F8FA";
      }
    };

    for (const b of buttons) {
      b.hidden = false;
      b.addEventListener("click", () => {
        const next = isDark() ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("obdaryn-theme", next); } catch {}
        sync();
      });
    }
    systemDark.addEventListener("change", sync);
    sync();

    // Back to top: shown after about a screen and a half of scrolling. It scrolls
    // without adding #top to the address and puts the keyboard focus back at the top.
    const toTop = document.querySelector<HTMLAnchorElement>("[data-to-top]");
    if (toTop) {
      toTop.hidden = false;
      const update = () => toTop.classList.toggle("shown", window.scrollY > window.innerHeight * 1.5);
      window.addEventListener("scroll", update, { passive: true });
      update();
      toTop.addEventListener("click", (event) => {
        event.preventDefault();
        const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        window.scrollTo({ top: 0, behavior: still ? "auto" : "smooth" });
        document.getElementById("top")?.focus({ preventScroll: true });
      });
    }
  </script>
</body>
</html>

<style>
  /* The top bar stays in view: solid ground, a hairline under it, above the page. */
  .top { position: sticky; top: 0; z-index: 10; background: var(--window); border-bottom: 1px solid var(--hairline); }
  .top-inner { display: flex; align-items: center; gap: var(--s4) var(--s6); min-height: var(--top-h); }
  .brand { display: inline-flex; align-items: center; gap: 12px; color: var(--text); text-decoration: none; font-weight: 700; font-size: 20px; letter-spacing: -0.015em; }
  .brand img { width: 36px; height: 36px; flex: none; }
  .top .brand { margin-right: auto; }
  nav ul { display: flex; align-items: center; flex-wrap: wrap; gap: var(--s1) var(--s5); list-style: none; padding: 0; }
  nav a { color: var(--text-muted); text-decoration: none; font-size: 15px; font-weight: 500; padding: 6px 0; transition: color var(--fast) var(--ease); }
  nav a:hover, nav a[aria-current="page"] { color: var(--text); }
  nav a[aria-current="page"] { font-weight: 600; }

  /* Theme button and language switch: two quiet outlined controls of one height. */
  .tools { display: flex; align-items: center; gap: var(--s2); }
  .gh, .theme, .lang {
    display: inline-flex; align-items: center; justify-content: center; height: 34px;
    border: 1px solid var(--field-border); border-radius: var(--radius); background: transparent;
    color: var(--text-muted); text-decoration: none; font: 500 15px/1 var(--sans);
    transition: background-color var(--fast) var(--ease), color var(--fast) var(--ease);
  }
  .gh, .theme { width: 34px; padding: 0; }
  .theme { cursor: pointer; }
  .gh :global(svg) { width: 18px; height: 18px; }
  .theme[hidden] { display: none; }
  .theme :global(svg) { width: 18px; height: 18px; }
  .lang { padding: 0 11px; }
  .gh:hover, .theme:hover, .lang:hover { background: var(--hover); color: var(--text); }
  /* Narrow windows and phones: the brand and the two controls on the first row,
     the links under them (--top-h in global.css matches this height). */
  @media (max-width: 800px) {
    .top-inner { flex-wrap: wrap; padding-block: 10px 6px; gap: 6px var(--s3); min-height: 0; }
    .brand { font-size: 18px; gap: 10px; }
    .brand img { width: 32px; height: 32px; }
    nav { order: 3; width: 100%; }
    nav ul { gap: var(--s1) var(--s4); }
    nav a { font-size: 14px; }
  }

  /* The bottom padding keeps the last line clear of the back-to-top button. */
  .foot { margin-top: var(--s9); border-top: 1px solid var(--hairline); background: var(--sidebar); padding-bottom: 56px; }
  .foot-inner { display: grid; grid-template-columns: 1fr auto; gap: var(--s5) var(--s7); padding-block: var(--s7); }
  .foot .brand { font-size: 18px; gap: 10px; }
  .foot .brand img { width: 32px; height: 32px; }
  .foot-brand p { color: var(--text-muted); font-size: 15px; margin-top: var(--s3); }
  .foot-links { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, auto); gap: var(--s2) var(--s7); align-content: start; }
  .foot-links a { color: var(--text-muted); text-decoration: none; font-size: 15px; }
  @media (pointer: coarse) { .foot-links { row-gap: 0; } .foot-links a { display: inline-block; padding-block: 12px; } }
  .foot-links a:hover { color: var(--text); text-decoration: underline; }
  .foot-brand .coffee-note { margin-top: var(--s4); font-size: 14px; color: var(--text-faint); }
  .coffee {
    display: inline-flex; align-items: center; gap: 8px; height: 36px; margin-top: var(--s2); padding: 0 14px;
    border: 1px solid var(--field-border); border-radius: var(--radius); color: var(--text); text-decoration: none;
    font: 500 15px/1 var(--sans); transition: background-color var(--fast) var(--ease);
  }
  .coffee :global(svg) { color: var(--amber); }
  .coffee:hover { background: var(--hover); }

  /* Back to top: a quiet control like the theme button, bottom right, above the page. */
  .to-top {
    position: fixed; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom)); z-index: 9;
    display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px;
    border: 1px solid var(--field-border); border-radius: var(--radius); background: var(--window); color: var(--text-muted);
    box-shadow: 0 6px 18px -8px rgb(0 0 0 / 0.35);
    opacity: 0; transform: translateY(8px); pointer-events: none; visibility: hidden;
    transition: opacity var(--normal) var(--ease), transform var(--normal) var(--ease), visibility 0s linear var(--normal),
                background-color var(--fast) var(--ease), color var(--fast) var(--ease);
  }
  .to-top[hidden] { display: none; }
  .to-top.shown { opacity: 1; transform: none; pointer-events: auto; visibility: visible; transition-delay: 0s; }
  .to-top:hover { background: var(--hover); color: var(--text); }
  .to-top :global(svg) { width: 20px; height: 20px; }
  @media (prefers-reduced-motion: reduce) { .to-top { transform: none; } }
  .top:focus { outline: none; }
  .foot-links .with-mark { display: inline-flex; align-items: center; gap: 7px; vertical-align: top; }
  .foot-small { grid-column: 1 / -1; display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s2) var(--s5); border-top: 1px solid var(--hairline); padding-top: var(--s4); font-size: 13px; color: var(--text-faint); }
  @media (max-width: 640px) { .foot-inner { grid-template-columns: 1fr; } }
</style>
