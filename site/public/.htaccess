# Used when HestiaCP serves the site through Apache (nginx-only templates ignore it).
ErrorDocument 404 /404.html

# The server has mod_pagespeed on, which renames and recompresses the build's images
# and merges its stylesheets. The build is already optimised, so serve it as built.
<IfModule pagespeed_module>
  ModPagespeed off
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  # Hashed build assets (/_astro/) never change; everything else is revalidated.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
